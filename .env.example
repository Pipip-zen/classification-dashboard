# ==============================================================================
# KONFIGURASI GROUND CONTROL STATION (GCS) - ENVIRONMENT VARIABLES
# ==============================================================================

# Port & Host binding FastAPI Uvicorn
PORT=8000
HOST=0.0.0.0
NO_BROWSER=1

# Mode Inferensi (cpu / cuda)
DEVICE=cpu

# PIN untuk ambil alih paksa channel Operator jika bentrok
OPERATOR_PIN=1234

# Otentikasi & 3 Akun Peran (Wajib diganti saat deploy produksi VPS!)
AUTH_SECRET=vanguard-tactical-gcs-dev-secret-change-me
DRONE_USERNAME=drone
DRONE_PASSWORD=drone123
ROV_USERNAME=rov
ROV_PASSWORD=rov123
SPECTATOR_USERNAME=spectator
SPECTATOR_PASSWORD=spectator123

# Log Level (debug, info, warning, error)
LOG_LEVEL=info

# Token Cloudflare Tunnel (Opsional: dari Cloudflare Zero Trust -> Networks -> Tunnels)
# Jika diisi, jalankan: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
COMPOSE_PROFILES=tunnel

# Domain VPS (opsional untuk sertifikat SSL Let's Encrypt)
DOMAIN=gcs.yourdomain.com
EMAIL=admin@yourdomain.com
