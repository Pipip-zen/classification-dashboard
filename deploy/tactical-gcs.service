[Unit]
Description=Tactical AI Ground Control Station (GCS)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/tactical-gcs
ExecStart=/opt/tactical-gcs/.venv/bin/uvicorn server.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
Environment="PYTHONUNBUFFERED=1"
Environment="PORT=8000"
Environment="HOST=0.0.0.0"
Environment="NO_BROWSER=1"

[Install]
WantedBy=multi-user.target
